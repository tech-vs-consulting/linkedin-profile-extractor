{
  "manifest_version": 3,
  "name": "LinkedIn Profile Extractor",
  "version": "1.0.0",
  "description": "Extrait nom, photo, titre, entreprise et historique de postes depuis une page de profil LinkedIn.",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Profile Extractor"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
