{
  "manifest_version": 3,
  "name": "LinkedIn Profile Extractor",
  "version": "1.2.0",
  "description": "Recherche de prospects LinkedIn par campagne, extraction de profils, dashboard et synchronisation Notion.",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "storage", "scripting", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.notion.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Profile Extractor"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js", "search.js", "outreach.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
